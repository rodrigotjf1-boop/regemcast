# Endereço da API, lido em RUNTIME pelo servidor Next — não é embutido no
# bundle. Trocar e reiniciar basta; rebuildar não é necessário.
API_URL_PUBLICA=http://localhost:3010/api/v1

# Base publica DESTE site. Vira o metadataBase do Next: sem ela, a imagem de
# previa do link resolve contra localhost e a previa quebra ao compartilhar.
APP_URL_PUBLICA=http://localhost:3011
