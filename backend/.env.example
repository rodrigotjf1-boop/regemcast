# ---------- banco ----------
# Usuario da aplicacao: regemcast_app, SEM bypassrls (ver database/migrations/000_roles.sql).
DATABASE_URL=postgres://regemcast_app:TROQUE@localhost:5432/regemcast
# TLS do banco: disable | require | supabase | no-verify
#   supabase  -> use ESTE com Supabase (direto ou pelo pooler). A raiz deles e
#                auto-assinada e nao esta no bundle do Node; com require puro a
#                conexao morre com SELF_SIGNED_CERT_IN_CHAIN. A CA vem no
#                repositorio, em backend/certs/.
#   require   -> verifica pelas CAs do sistema. Serve para Postgres com
#                certificado de CA publica.
#   no-verify -> criptografa sem verificar quem esta do outro lado. Escape de
#                emergencia; grita no log a cada boot.
DATABASE_SSL=supabase
# Sobrepoe o modo acima com uma CA propria. Aceita o PEM ou o PEM em base64.
DATABASE_CA_CERT=
# So para `npm run migrate`: regemcast_app NAO tem CREATE no schema public (por
# construcao), entao quem aplica DDL e o dono do banco (no Supabase: postgres).
# Sem esta variavel o runner cai na DATABASE_URL e para com a mensagem
# explicando o que falta. Passo a passo em docs/banco.md.
MIGRATION_DATABASE_URL=postgres://postgres:TROQUE@localhost:5432/regemcast

# ---------- fila ----------
REDIS_URL=redis://localhost:6379

# ---------- sessao ----------
# openssl rand -base64 48
JWT_SECRET=
JWT_TTL_HORAS=12
# Validade da sessao do APLICATIVO Android, em dias (a web usa JWT_TTL_HORAS).
JWT_TTL_APP_DIAS=30
COOKIE_NOME=regemcast_sess
COOKIE_DOMINIO=

# ---------- console de distribuicao ----------
# Portao UNICO das rotas /lista-espera de leitura e convite: elas enxergam a
# fila inteira, de todas as contas, e nao pertencem ao cliente. Sem esta
# variavel a API responde 503 nessas rotas (fail-closed de proposito: variavel
# esquecida no deploy nao pode virar console interno aberto).
# Gere com: openssl rand -hex 32
# Minimo de 24 caracteres. Em producao, token menor que isso mantem a rota em
# 503 ate alguem gerar um decente; em dev, so avisa no log.
# Envie no cabecalho x-dist-token. Nunca comite o valor real.
DIST_TOKEN=

# ---------- rede ----------
PORT=3010
APP_URL=http://localhost:3011
API_URL=http://localhost:3010
CORS_ORIGIN=http://localhost:3011
TRUST_PROXY=1
TRUST_CLOUDFLARE=false
SWAGGER_ENABLED=true

# ---------- Meta / WhatsApp Cloud API (Fase 1) ----------
# App NOVO, no portfolio ja verificado do Regem.
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_CONFIG_ID=
META_GRAPH_VERSAO=v25.0
# Chave de cifra dos tokens por conta (AES-256-GCM). openssl rand -base64 32
META_TOKEN_CHAVE=

# ---------- rastreio de clique ----------
# ATENCAO: este dominio fica CONGELADO dentro de cada template aprovado pela
# Meta. Trocar depois obriga a recriar e reaprovar TODOS os modelos, com nome
# novo. Decidir antes do primeiro template submetido.
RASTREIO_BASE_URL=http://localhost:3010/r

# ---------- storage ----------
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=regemcast-midia

# ---------------------------------------------------------------- e-mail
# Resend (https://resend.com): códigos de verificação e convites.
# Sem a chave, fora de produção o e-mail vai para o LOG; em produção o envio
# recusa com 503. O domínio do remetente precisa estar verificado no Resend.
# Conta Resend PRÓPRIA do RegemCast, domínio dmstecnologias.com. NÃO cadastrar
# dmsregem.com em outra conta: o Regem já usa esse domínio no Resend e o DKIM
# (resend._domainkey) seria sobrescrito, derrubando os e-mails do Regem.
RESEND_API_KEY=
EMAIL_REMETENTE=RegemCast <nao-responda@dmstecnologias.com>

# ------------------------------------------------- segurança dos clientes
# Cifra o segredo do aplicativo autenticador dos CLIENTES. Chave própria,
# diferente de DIST_TOTP_CHAVE e META_TOKEN_CHAVE. 32 bytes em base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Não troque depois de alguém ativar o app: os códigos cadastrados param.
CONTA_TOTP_CHAVE=

# Clientes novos por janela de 7 dias (teto da Meta para Tech Provider):
# 10 até a Access Verification sair; 200 depois dela.
TETO_CLIENTES_NOVOS_7D=10

# ------------------------------------------------------------- cobrança
# Mercado Pago da SISTER TECNOLOGIA (developers → aplicação RegemCast).
# Comece pelas credenciais de TESTE; troque pelas de produção depois de validar.
# Sem o token, contratar plano responde 503 dizendo o que falta.
MP_ACCESS_TOKEN=
# Assinatura secreta dos webhooks (Webhooks → configurar). Sem ela, nenhum aviso
# é processado: aviso sem assinatura conferida não ativa plano de ninguém.
MP_WEBHOOK_SEGREDO=
# Dias depois do vencimento sem pagamento até os disparos pararem.
CARENCIA_DIAS=5

# ------------------------------------------------- DMS ID (Hub DMS, porta MCP)
# A porta MCP aceita, ao lado do token rct_it_, o token do DMS ID com o segredo
# da ligacao (cabecalho DMS-Ligacao). Desligado, nada muda. Ligado, as tres
# abaixo sao obrigatorias e a API nao sobe sem elas. Nenhuma e segredo.
DMS_ID_LIGADO=false
# O emissor do DMS ID (o "iss" dos tokens), sem barra no fim.
DMS_ID_EMISSOR=
# O endereco da porta MCP como o DMS ID o conhece (o "aud" dos tokens e o
# "resource" dos metadados), sem barra no fim.
DMS_ID_RECURSO=
# Produto -> client_id do aplicativo no DMS ID, em JSON numa linha so:
#   {"liame":"<client_id do Liame no DMS ID>"}
DMS_ID_APLICATIVOS=

# ------------------------------------- Autorizacao por clique (Hub DMS, etapa B1)
# O dono liga um aplicativo do DMS ID na pagina /integracoes/autorizar, com a
# senha, sem token da distribuicao. Desligada, o pedido e a troca respondem 404.
# Ligada, exige DMS_ID_LIGADO=true e as duas de baixo (a pagina mostra a empresa
# dona do aplicativo), e a API nao sobe sem elas. Nenhuma e segredo.
AUTORIZACAO_POR_CLIQUE=false
# A razao social e o CNPJ da DMS, como a tela mostra para os produtos da DMS.
AUTORIZACAO_DMS_RAZAO_SOCIAL=
AUTORIZACAO_DMS_CNPJ=
# Opcional, para teste: troca a lista de enderecos de volta de um aplicativo.
#   {"liame":["http://localhost:3001/v1/oauth/callback"]}
AUTORIZACAO_ENDERECOS_DE_VOLTA=

# ------------------------------------------------ Hub da DMS (registro e parada)
# A porta MCP manda ao hub o registro de cada chamada (quem chamou, a ferramenta,
# o resultado e a duracao; nunca o conteudo) e os erros da API, e consulta a
# lista de parada. Desligado, nada sai daqui. Ligado, as cinco de baixo sao
# obrigatorias (DMS_ID_EMISSOR e a mesma do bloco acima) e a API nao sobe sem
# elas.
HUB_LIGADO=false
# O endereco do hub, sem barra no fim.
HUB_URL=
# O identificador do recurso do hub no DMS ID (o destino do token).
HUB_RECURSO=
# O client_id do aplicativo do RegemCast no DMS ID (maquina para maquina, com
# as permissoes registro.enviar e parada.ler do recurso do hub).
HUB_APLICATIVO=
# SEGREDO: o segredo desse aplicativo. Nunca em repositorio nem em log.
HUB_SEGREDO=
# A chave propria do Padrao DMS: false recusa toda chamada de integracao (503
# integracao-parada), com ou sem o hub. Emergencia sem o hub: mudar para false.
ACEITAR_INTEGRACOES=true
